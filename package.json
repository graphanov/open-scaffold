{
  "name": "open-scaffold",
  "version": "0.4.1",
  "description": "Runtime-neutral scaffold and prompt/artifact CLI for disciplined AI-agent development.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osc": "dist/cli.js",
    "open-scaffold": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "smoke:e2e": "vitest run tests/e2e/lifecycle.test.ts",
    "osc": "tsx src/cli.ts"
  },
  "files": [
    "dist",
    ".osc/RULES.md",
    ".osc/plans/WORKFLOW.md",
    ".osc/plans/README.md",
    ".osc/plans/handoff-template.md",
    ".osc/releases/README.md",
    ".osc/specs/.gitkeep",
    "docs",
    "README.md",
    "LICENSE",
    "amend.sh",
    "bootstrap.sh",
    "close.sh",
    "delegate.sh",
    "verify.sh"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
